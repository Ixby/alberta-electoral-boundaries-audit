		cta_methods: 'ᐊᐧᐸᐦᑎ ᐅᐦᒋ ᑲᑭ-ᐊᑎᐧᐦᑕᐦᐊᐦᑭ →',
		scorecard_h: 'ᐅᒪ ᑲᑎᔅᑫᐦᐃᑫᐃᐧᐣ',
		scorecard_fig_alt:
			'ᐃᐢᒍᐢᐅᐢᒋᑫᐃᐧᐣ ᐊᔪᐢᑎᐦᐃᐦᑲᐧᐠ: ᑮᐢᐱᔥᑭᔥᑲᒪᑲᐧᐃᐧᐣ ᐅᐧᔭᐢᑲᐃᐧᐣ ᐱᒥᒋᐢᑖᑲᐧᐠ ᐊᐧᔭᔅᑭ, ᓂᓯᔥᑲᐢᒋᑫᐃᐧᓇ ᑲᐃᐧ-ᐊᑎᐧᓂᑎᔭᐠ ᐃᔥᐱᒪᐢ. ᐊᐢᑭ-ᑮᔓᐦᐃᑫᐃᐧᐣ 2019 ᐁᑲᐧ 2026 ᒥᐦᒋᑌᐃᐧᐣ ᐊᐢᑖᐃᐧᐣ ᒪᒪᐃᐧᔭᑦ ᐊᐦᐱᐦᐃᔅ ᐊᔪᐢᑎᐦᐃᐦᑲᐧᐠ. 2026 ᐊᑎᐦᑌᑫᐧᐃᐧᐣ ᐅᔑᐦᑖᐃᐧᐣ ᐯᔭᑯᔥᑲᓄᔅᑫᐃᐧᐤ ᐃᔥᐱᒪᐢ-ᐊᐧᔭᔅᑭ ᐊᔮᓂᑲᔥᒋᑫᐃᐧᐣ.',
		scorecard_fig_caption:
			'ᓂᔓ ᐊᔪᐢᑎᐦᐃᑫᐃᐧᓇ ᐯᔭᑲᐧᔣᐠ ᑎᐢᑲᐧᐦᐃᑫᐃᐧᐣ. ᐱᒥᒋᐢᑖᑲᐧᐠ: ᐃᐢᐱᐦᑌᐧᐃᐧᐣ ᐊᔭᔥᐱᔅᑫᐧᐃᐧᐣ (ᐊᐧᔭᔅᑭ = ᒥᐢᒋᐢᑖᑲᐧᐠ UCP-ᐊᔮᔅᑫᐧᐢᑌᐃᐧᓇᐤ). ᐃᔥᐱᒪᐢ: ᑖᓂ ᓂᓯᔥᑲᐢᒋᑫᐃᐧᓇ ᐊᑎᐧᓂᑎᔭᐠ. ᐃᑎᐢᑲᐧᐠ-ᐊᐧᔭᔅᑭ ᑲᐦᑭᔭᐤ ᑫᐧᐢᑌᔅᑭᔅᑫᐃᐧᐣ. ᐃᔥᐱᒪᐢ-ᐊᐧᔭᔅᑭ ᐊᔮᓂᑲᔥᒋᑫᐃᐧᐣ. 2019 ᐁᑲᐧ 2026 ᒥᐦᒋᑌᐃᐧᐣ ᐊᐢᑎᐃᐧᐣ ᑲᐦᑭᔭᐤ ᑫᐧᐢᑌᔅᑭᔅᑫᐃᐧᐦᐠ. 2026 ᐊᑎᐦᑌᑫᐧᐃᐧᐣ ᐊᐢᑎᐃᐧᐣ ᐯᔭᑯᔥᑲᓄ ᐊᔮᓂᑲᔥᒋᑫᐃᐧᐦᐠ.',
		scorecard_intro:
			'ᓂᔓ ᐱᔅᑭᔥᑲᓂ ᑎᐯᔨᒋᑫᐃᐧᓇ ᐋᐸᒋᐦᑖᑲᐧᐤ ᓂᔣᒃ ᐊᐢᑭ-ᑮᔓᐦᐃᑫᐃᐧᓇ ᑲᐧᔭᐢᐠ ᐯᔭᑲᐧᐦᐊᑲᐃᐧᐣ ᐱᒥᐊᑲᐢᒋᑫᐃᐧᓇ. ᐊᐢᑭ-ᐊᔭᒪᐦᐃᑭᐃᐧᐣ ᐋᐸᒋᐦᑖᑲᐧᐤ ᐱᑯ ᐊᐢᑭ-ᑮᔓᐦᐃᑫᐃᐧᓇ ᓇᐱᓀᔅᑲᐢᒋᑫᐃᐧᐣ — ᓇᒪᐃᐧᔭ ᐊᐢᑭ-ᐃᔥᐃᐧᐃᐧᐣ. ᐊᑭᐦᑌᐃᐧᓇ ᑎᐯᔨᒋᑫᐤ ᑖᓂ ᐊᐢᑭ-ᑮᔓᐦᐃᑫᐃᐧᓇ ᐊᔭᒥᐦᑲᐧᔣᑲᐧᐤ ᐃᔥᐃᐧᐃᐧᓇ ᑫᐧᐢᑕᐱᐃᐧᓇᐠ. ᓂᔣᒃ ᐯᔭᐠ ᐃᔑᓂᑲᑫᐃᐧᐣ.',
		scorecard_close:
			'ᓂᔓ ᐱᔅᑭᔥᑲᓂ ᑎᐯᔨᒋᑫᐃᐧᓇ, ᐯᔭᐠ ᓇᐢᑲᐧᒧᐃᐧᐣ. ᐊᓂᒪ ᐯᔭᑲᐧᔣᐠ ᐃᔑᓇᑲᐧᐣ ᐊᔭᒥᐦᐁᐢᑕᒪᑫᐃᐧᐣ ᐅᐦᒋ-ᒪᐢᑲᐃᐧᐦᑌᐤ ᑭᔅᑌᐧᐦᐊᑭᐃᐧᐣ.'
	},
	top_callouts: {
		gerrymander_lead: 'ᐅᒪ ᐊᑎᐦᑌᑫᐧᐃᐧᐣ ᐊᐢᑭ-ᑮᔓᐦᐃᑫᐃᐧᐣ ᓇᔭᑫᐧᔪᐤ ᒨᔭ-ᑲᐧᔭᐢᑭ-ᐃᔑᓇᐦᐃᑫᐃᐧᐣ (gerrymander)?',
		gerrymander_body: 'ᒪᒪᐃᐧᐢᑌᐃᐧᐣ ᐊᑎᐦᑌᑫᐧᐃᐧᐣ ᐊᐢᑭ-ᑮᔓᐦᐃᑫᐃᐧᐣ ᐯᔭᐠ ᐱᑯ ᐃᔑᓇᑲᐧᐣ ᐊᓂᒪ 14.5&nbsp;million ᐃᔑᓂᔥᑌᑫᐠ ᐊᐢᑭ-ᑮᔓᐦᐃᑫᐃᐧᓇ. ᒥᐦᒋᑌᐃᐧᐣ ᐊᐢᑭ-ᑮᔓᐦᐃᑫᐃᐧᐣ ᑲᐧᔭᐢᐠ ᐊᐢᑖᐤ.',
		tldr_label: 'ᑭᒋ-ᑌᐱᐢᑫᔨᐦᒋᑲᐣ',
		tldr_p1: 'ᐊᓚᐱᕐᑌᐃᐧᐠ ᐊᐢᑭ-ᑮᔓᐦᐃᑫᐃᐧᐣ ᒪᒪᐃᐧᐢᑌᐃᐧᐣ ᑮ-ᒪᔥᑭᐢᑫᔨᐦᑕᒬᐤ 3&ndash;2 ᐊᐢᐱᐦᐃᔅ 2026 ᐁᑲᐧ ᑮ-ᐅᔑᐦᑖᐤ ᓂᔓ ᐱᐢᑭᔥᑲᓄᐠ ᐊᐢᑭ-ᑮᔓᐦᐃᑫᐃᐧᓇ. ᐃᔥᑭᐊᐧᐠ ᐅᑭᒪᐤᐃᐧᐣ ᓂᔣᒃ ᑮ-ᐅᐦᑎᓂᐦᑲᑌᐤ ᐁᑲᐧ ᑮ-ᒥᔭᐤ ᐊᐢᑭ-ᑮᔓᐦᐃᑫᐃᐧᐣ ᓂᔮᓀᐡᐠ MLAs ᒪᒪᐃᐧᐢᑌᐃᐧᓂᐦᐠ (Lunty ᒪᒪᐃᐧᐢᑌᐃᐧᐣ), ᐯᐦᐱᔓᐦᑭᑲᑌᐤ November 2026. ᓂᔣᒃ ᒪᒪᐃᐧᐢᑌᐃᐧᐣ ᐊᐢᑭ-ᑮᔓᐦᐃᑫᐃᐧᓇ ᓇᒪᐃᐧᔭ ᐃᐧᔭᓯᐁᐧᐃᐧᐣ ᓀᑎ.',
		tldr_p2: 'ᐅᒪ ᐊᔭᒥᐦᐁᐢᑕᒪᑫᐃᐧᐣ ᑮ-ᑎᐯᔨᒋᑫᐤ ᓂᔣᒃ ᒪᒪᐃᐧᐢᑌᐃᐧᐣ ᐊᐢᑭ-ᑮᔓᐦᐃᑫᐃᐧᓇ ᐯᔭᑲᐧᔣᐠ ᐃᔥᐃᐧᔮᐦᑲᐧᐤ, ᐋᐸᒋᐦᑖᑲᐧᐤ 1,010,000 ᒪᔥᑭᔅᑌᐃᐧᓂᐦᐠ ᑲᐧᔭᐢᐠ ᐊᐢᑭ-ᑮᔓᐦᐃᑫᐃᐧᓇ ᐅᐦᑎᓂᐦᑲᑌᐃᐧᓇ Elections Alberta ᑮᔓᐦᐃᑫᐃᐧᓇ. ᒥᐦᒋᑌᐃᐧᐣ ᐅᔑᐦᑖᐃᐧᐣ ᐊᐢᑖᐤ ᑲᐧᔭᐢᑭ-ᐃᔑᐃᐧᐠ ᒥᓯᐁᐧ ᐯᐦᐱᔓᐦᑲᑌᐠ ᓂᓯᔥᑲᐢᒋᑫᐃᐧᓇ. ᐊᑎᐦᑌᑫᐧᐃᐧᐣ ᐅᔑᐦᑖᐃᐧᐣ ᑮ-ᐊᑎᐧᓂᑎᔭᐠ ᓀᐅᐧᐠ ᓂᔭᓄᐠ ᐊᐢᑭ-ᑮᔓᐦᐃᑫᐃᐧᓇ ᓂᓯᔥᑲᐢᒋᑫᐃᐧᓇ, ᐁᑲᐧ ᐊᓂᒪ ᐅᔭᔥᑫᐧᔪᑲᐧᐠ ᑫᐧᐢᑕᐱᐃᐧᐣ ᐊᔭᔥᐱᔅᑫᐧᐃᐧᐣ 50/50 ᐊᐢᐃᐧᐢᑌᐃᐧᐣ ᐊᓂᒪ ᓇᒪᐃᐧᔭ 100 ᐅᐦᒋ 1.01 million ᐊᐢᑭ-ᑮᔓᐦᐃᑫᐃᐧᓇ ᐅᐢᑖᐤ — ᐊᓲᔭᐠ ᐊᓂᒪ ᐯᔭᑲᐧᔣᐠ ᐅᐦᒋ ᑮᐢᑖᐢᑲᐅᔮᐢᑎᑫᐃᐧᐣ ᐯᔭᐠ ᐊᓂᒪ 15 ᒥᔭᔥᑲᒥᑲᓀᓂᐦᑲᑌᐠ.',
		tldr_p3: 'ᐅᒪ ᐊᔭᒥᐦᐁᐢᑕᒪᑫᐃᐧᐣ ᑎᐯᔨᒋᑫᐤ ᐃᔑᓇᑲᐧᐣ, ᓇᒪᐃᐧᔭ ᑌᐦᐃᑫᐃᐧᐣ. ᐃᔥᐱ Lunty ᒪᒪᐃᐧᐢᑌᐃᐧᐣ ᐅᔑᐦᑖᐃᐧᐣ ᐊᐢᑭ-ᑮᔓᐦᐃᑫᐃᐧᐣ ᑭ-ᐱᑭᔅᑫᔨᐦᑖᐠ, ᐅᒪ ᐊᔭᒥᐦᐁᐢᑕᒪᑫᐃᐧᐣ ᐊᔮᓂᒋᐦᑖᐤ ᐯᔭᑯᔥᑲᓄᐠ ᓂᓯᔥᑲᐢᒋᑫᐃᐧᓇ.',
		tldr_footer: 'ᐯᐢᑌᐧᐦᐱᔮᑭᐦᐃᑫᐃᐧᐣ ᐃᐧᔭᓯᐁᐧᐃᐧᓇ ᐁᑲᐧ ᐊᑭᐦᐢᑖᑲᐧᐦᐃᑫᐃᐧᓇ ᐊᐢᑌᐤ %s.',
		tldr_footer_link: '§9'
	},
	head: {
