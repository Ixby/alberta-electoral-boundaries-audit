__pycache__/
*.pyc
*.pyo
*.log

# Build-pipeline intermediate outputs — only the merged report_public.pdf
# is the published artefact; article.pdf and article.html are regenerated
# on every build and create commit noise.
article.pdf
article.html
.env
venv/
.venv/
*.egg-info/
dist/
build/
.DS_Store
.temp/
cache/
analysis/logs/
private/
maps/pdf_previews/
analysis/scripts/*.csv

# Pipeline-internal scratch directories — final outputs are written
# elsewhere and these are deleted on successful completion.
data/shapefiles/derived/_perfecter_checkpoints/
data/mcmc_checkpoints_*/
# But preserve the per-chain metric CSVs via Git LFS — these are the
# actual numerical record of every ReCom step in the published ensembles.
!data/mcmc_checkpoints_*/chain*_samples.csv

# Orphan output directory — scripts that target data/maps/ sometimes land
# here when the working directory is wrong; the canonical copy lives in
# data/maps/.
/maps/

# MCMC raw sample CSVs >100MB — keep percentiles + diagnostics + log instead
data/v0_1_mcmc_ensemble_samples_*.csv

# All MCMC simulation checkpoint directories (canonical and variant runs)
data/simulation_checkpoints_*/

# Raw census data >100MB — metadata files tracked, bulk data is not
data/raw/98-401-X2021024_English_CSV_data.csv

# Source-check reference PDFs — local copies of cited papers, not committed
analysis/methodology/source_checks/*.pdf
analysis/methodology/source_checks/*.PDF
analysis/methodology/source_checks/*.zip

# OSM debug-only raw Overpass JSONs — the GPKG (3x smaller) is the
# canonical committed cache; the JSON preserves raw tag dictionaries for
# future filtering work and is regenerated on demand by
# analysis/scripts/_fetch_osm_natural.py.
data/osm/*.json

# Outreach emails — drafts and sent log; never committed (contain personal contact details)
emails/

# Scratch / scratchpad scripts at repo root (e.g. scratch_lassos.py).
# These are PO working files / one-off probes — not part of the canonical
# pipeline. Canonical scripts live under analysis/scripts/. Add specific
# scratch files explicitly only if you want them tracked.
/scratch_*.py
private_notes/

# Private workspace — credentials, personal notes, working drafts, email logs
# Contains key.env, entities.json, mempalace.yaml, OSF scripts, ap scripts,
# report drafts, six-hat analyses, and live task logs. Never commit.
private_workspace/

# Claude Code session bootstrap — internal guidance for AI sessions; not public
CLAUDE.md

# Operational infrastructure — pipeline watchdogs, poller scripts, PS1 runners
# Local execution helpers, not part of the reproducible analysis pipeline.
analysis/ops/

# Internal tooling — one-off build helpers and refactor scripts
analysis/tools/

# MCMC operational recovery scripts — internal workflow artifacts
run_chain1_recovery.py

# Intermediate computation checkpoints
data/outputs/checkpoints/

# Per-edit internal analysis artifacts
data/outputs/per_edit_*
analysis/scripts/per_edit_*
analysis/scripts/PER_EDIT_*

# Backup files
*.bak

# Interactive proofs app — npm dependencies and compiled build output
# interactive_proofs/ was the pre-'Commit A' app dir; its source was relocated
# (now viewer/) and the leftover husk deleted in the 2026-07-09 cruft sweep.

# Stray repo-root node_modules — created when an `npx` / `npm` command is
# accidentally run from the repo root instead of viewer/. The viewer's own
# node_modules is ignored by viewer/.gitignore.
/node_modules/

# 338Canada raw scraped HTML — regenerated by analysis/scripts/338canada_scraper.py
# Derived CSV outputs are committed; the raw HTML is not needed for reproducibility
data/reference/polling_338_historical/

# Draft infographic assets — distributed in supplemental zip, not canonical analysis
outputs/assets/

# Internal QA verification map snapshots — moved to dpg/verification/
tests/logs/

# Large binary archives in archive/ — tracked via README only, not the zip blobs
archive/*.zip

# Synthetic dry-run inputs — regenerated deterministically from labeled seed
# (See proposals/lunty_dry_run/generate_synthetic_91.py)
proposals/lunty_dry_run/*.gpkg
data/outputs/szat_swing_va_canonical.gpkg

# Claude Code local/session state — never commit (shared .claude config stays tracked)
.claude/*.local.*

# Repo hygiene (2026-07-09 cruft sweep). The corrupt UTF-16LE 'private_notes/'
# entry that a PowerShell '>>' redirect embedded above this point (NUL bytes;
# git attributed directory-ignore decisions to a NUL pattern) was removed in
# the same sweep.
.pytest_cache/
.claude/
/.svelte-kit/
viewer/dev/
findings/osi_rebuild/.weights_cache/
findings/osi_rebuild/.weights_cache_v2/
findings/amendment12_replays/claims/
findings/amendment12_replays/*.log
findings/hybrid_regions/worker*.log
