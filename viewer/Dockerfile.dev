# Dev-only image: runs the SvelteKit/Vite dev server under Linux so the Windows
# host's file-locking (EBUSY on the watched ~38MB tile in build/) and background-
# process flakiness can't crash it. Source + data are bind-mounted at runtime
# (see docker-compose.dev.yml); only npm deps are baked in here for layer caching.
FROM node:22-bookworm-slim
WORKDIR /app/viewer
COPY package.json package-lock.json ./
RUN npm ci
EXPOSE 5180
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5180"]
